---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Icono from '../components/Icono.astro';
import Parada from '../components/Parada.astro';
import { lugares, regiones, comidas, barrios } from '../lib/datos';
import logo from '../assets/logo-cookfoodie.png';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/reviews/*.{jpg,jpeg,png,webp}', { eager: true });
// Mosaico: una foto por reseña (la primera), en el orden de las favoritas de Chris.
const pool = lugares
  .filter((l) => l.review?.images?.length)
  .map((l) => ({ slug: l.slug, name: l.name, img: fotos[`../assets/reviews/${l.review!.images[0].file}`]?.default, alt: l.review!.images[0].caption || l.name }))
  .filter((f) => f.img);
const casillas = Array.from({ length: 4 }, (_, i) => [pool[i], pool[i + 4], pool[i + 8], pool[i + 12]].filter(Boolean));

const regionesUsadas = Object.entries(regiones).filter(([k]) => lugares.some((l) => l.region === k));
const comidasUsadas = Object.entries(comidas).filter(([k]) => lugares.some((l) => l.meals.includes(k)));
// Primero los lugares con fotos de Chris; el navegador después los baraja (con foto y sin foto por separado).
const conFoto = (l: (typeof lugares)[number]) => !!l.review?.images?.length;
const enLista = [...lugares.filter(conFoto), ...lugares.filter((l) => !conFoto(l))];
const datosCliente = enLista.map((l) => ({
  s: l.slug, n: l.name, lat: l.lat, lng: l.lng, r: l.region, m: l.meals, p: l.price,
  rv: !!l.review && l.review.status !== 'in_progress', h: l.hood, f: conFoto(l),
}));
const resenados = lugares.filter((l) => l.review && l.review.status !== 'in_progress').length;
---
<Base
  titulo="CookFoodie San Francisco · Where Chris eats"
  descripcion="53 San Francisco places Christian Van Der Henst recommends, from Burmese to Salvadoran, sorted by how close you are. Or answer five quick questions and get a plan.">

  <div class="en-campo portada-campo">
  <section class="portada envoltura" aria-labelledby="titular">
    <div class="portada-texto">
      <h1 id="titular" class="titular"><T en="Where Chris eats in San Francisco." es="Dónde come Chris en San Francisco." /></h1>
      <p class="bajada">
        <T en="53 places, from Burmese tea leaf salad to Salvadoran pupusas. Sorted by how close you are, or picked for you in five taps."
           es="53 lugares, de la ensalada birmana de hoja de té a las pupusas salvadoreñas. Ordenados por cercanía, o elegidos para ti en cinco clics." />
      </p>
      <div class="acciones">
        <button type="button" class="boton" data-cerca><Icono n="navegar" /><T en="Near me" es="Cerca de mí" /></button>
        <a class="boton borde" href="/juego"><Icono n="chispa" /><T en="Plan my meal" es="Arma tu plan" /></a>
      </div>
      <p class="portada-dato" data-globo aria-live="polite">
        <T en={`${resenados} full reviews, ${lugares.length - resenados} more on his list.`} es={`${resenados} reseñas completas y ${lugares.length - resenados} lugares más en su lista.`} />
      </p>
    </div>

    <div class="mosaico" data-mosaico>
      {casillas.map((grupo, i) => (
        <a class={`casilla c${i}`} href={`/places/${grupo[0].slug}`} data-casilla>
          {grupo.map((f, j) => (
            <Image src={f.img!} alt={f.alt} widths={i === 0 ? [480, 760] : [280, 440]} sizes={i === 0 ? '(max-width: 860px) 60vw, 380px' : '(max-width: 860px) 30vw, 190px'}
              loading={j === 0 ? 'eager' : 'lazy'} class:list={[{ visible: j === 0 }]} data-slug={f.slug} />
          ))}
        </a>
      ))}
    </div>
  </section>
  </div>

  <section id="guia" class="guia envoltura" aria-labelledby="guia-titulo">
    <div class="guia-cabeza">
      <h2 id="guia-titulo" class="guia-titulo"><T en="The guide" es="La guía" /></h2>
      <p class="guia-estado" data-estado aria-live="polite">
        <T en="53 places, the ones with Chris's photos first." es="53 lugares, primero los que tienen fotos de Chris." />
      </p>
    </div>

    <div class="controles">
      <div class="controles-ubicacion">
        <button type="button" class="boton chico" data-cerca><Icono n="navegar" /><T en="Near me" es="Cerca de mí" /></button>
        <label class="estoy-en">
          <span><T en="or I'm in" es="o estoy en" /></span>
          <select data-barrio>
            <option value="">…</option>
            {barrios.map((b) => <option value={b.id}>{b.name}</option>)}
          </select>
        </label>
        <div class="vistas" role="tablist" aria-label="View">
          <button type="button" role="tab" aria-selected="true" aria-controls="vista-lista" data-vista="lista"><Icono n="lista" /><T en="List" es="Lista" /></button>
          <button type="button" role="tab" aria-selected="false" aria-controls="vista-mapa" data-vista="mapa"><Icono n="mapa" /><T en="Map" es="Mapa" /></button>
        </div>
      </div>
      <p class="aviso" data-aviso hidden></p>

      <div class="filtros">
        <div class="filtro" role="group" aria-label="Cuisine">
          <span class="filtro-nombre"><T en="Cuisine" es="Cocina" /></span>
          <div class="chips">
            {regionesUsadas.map(([k, r]) => (
              <button type="button" class="chip" data-filtro="r" data-valor={k} aria-pressed="false"><T en={r.en} es={r.es} /></button>
            ))}
          </div>
        </div>
        <div class="filtro" role="group" aria-label="Meal">
          <span class="filtro-nombre"><T en="When" es="Cuándo" /></span>
          <div class="chips">
            {comidasUsadas.map(([k, c]) => (
              <button type="button" class="chip" data-filtro="m" data-valor={k} aria-pressed="false"><T en={c.en} es={c.es} /></button>
            ))}
          </div>
        </div>
        <div class="filtro" role="group" aria-label="Price">
          <span class="filtro-nombre"><T en="Price" es="Precio" /></span>
          <div class="chips">
            {['$', '$$', '$$$', '$$$$'].map((p) => <button type="button" class="chip num" data-filtro="p" data-valor={p} aria-pressed="false">{p}</button>)}
            <button type="button" class="chip" data-filtro="rv" data-valor="1" aria-pressed="false"><Icono n="estrella" /><T en="Reviewed by Chris" es="Con reseña de Chris" /></button>
            <button type="button" class="limpiar" data-limpiar hidden><Icono n="otra" /><T en="Clear" es="Quitar filtros" /></button>
          </div>
        </div>
      </div>
    </div>

    <div id="vista-lista" role="tabpanel" data-panel="lista">
      <ol class="lugares" data-lugares>
        {enLista.map((l, i) => <Parada lugar={l} prioridad={i < 3} />)}
      </ol>
      <div class="mas" data-mas-caja hidden>
        <button type="button" class="boton borde" data-mas></button>
      </div>
      <div class="vacio" data-vacio hidden>
        <p class="vacio-titulo"><T en="Nothing matches all of that." es="Nada cumple con todo eso." /></p>
        <p><T en="Drop a filter or two." es="Quita uno o dos filtros." /></p>
        <button type="button" class="boton chico" data-limpiar><Icono n="otra" /><T en="Clear filters" es="Quitar filtros" /></button>
      </div>
    </div>
    <div id="vista-mapa" role="tabpanel" data-panel="mapa" hidden>
      <div class="mapa" data-mapa></div>
    </div>
  </section>

  <section class="plan envoltura en-campo" aria-labelledby="plan-titulo">
    <Image src={logo} alt="" width={72} height={72} class="plan-logo" />
    <div>
      <h2 id="plan-titulo" class="plan-titulo"><T en="Can't decide? Let Cvander plan it." es="¿No te decides? Que Cvander te arme el plan." /></h2>
      <p><T en="Five quick questions, a different set every time: the World Cup, beer or mezcal, your agent ordering for the table. You get a place, a dish and two backups."
            es="Cinco preguntas rápidas, distintas cada vez: el Mundial, chela o mezcal, tu agente pidiendo para la mesa. Te llevas un lugar, un plato y dos opciones más." /></p>
    </div>
    <a class="boton" href="/juego"><Icono n="chispa" /><T en="Plan my meal" es="Arma tu plan" /></a>
  </section>

  <script type="application/json" id="datos-ruta" set:html={JSON.stringify({ lugares: datosCliente, barrios })} />
</Base>

<script>
  import { iniciarRuta } from '../scripts/ruta';
  import { iniciarMosaico } from '../scripts/mosaico';
  iniciarRuta();
  iniciarMosaico();
</script>

<style>
  /* ---------- Portada ---------- */
  .portada { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding-block: clamp(36px, 6vw, 80px) clamp(40px, 6vw, 72px); }
  .portada-texto { display: grid; gap: 20px; align-content: center; }
  .titular { font-size: clamp(2.5rem, 5.6vw, 4.4rem); font-weight: 750; letter-spacing: -0.045em; line-height: 1.02; max-width: 13ch; }
  .bajada { font-size: clamp(1.08rem, 1.5vw, 1.25rem); color: var(--texto-2); max-width: 44ch; }
  .acciones { display: flex; flex-wrap: wrap; gap: 10px; }
  .portada-dato { font-size: 0.92rem; color: var(--texto-3); font-weight: 550; }

  .mosaico { display: grid; grid-template-columns: 1.35fr 1fr 1fr; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 10px; aspect-ratio: 5 / 4; }
  .casilla { position: relative; overflow: hidden; border-radius: 14px; background: var(--placa-2); display: block; }
  .casilla.c0 { grid-row: span 2; }
  .casilla.c3 { grid-column: 2 / 4; }
  .casilla :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; clip-path: inset(100% 0 0 0); transform: scale(1.08); transition: clip-path 850ms var(--ease), transform 1600ms var(--ease); }
  .casilla :global(img.visible) { clip-path: inset(0); transform: scale(1); }
  .casilla :global(img.arriba) { z-index: 1; }
  .casilla:hover :global(img.visible) { transform: scale(1.03); }
  @media (max-width: 860px) {
    .portada { grid-template-columns: 1fr; padding-top: 28px; }
    .mosaico { order: -1; aspect-ratio: 16 / 10; grid-template-columns: 1.4fr 1fr; }
    .casilla.c0 { grid-row: span 2; }
    .casilla.c2, .casilla.c3 { display: none; }
    .titular { max-width: 16ch; }
  }

  /* ---------- La guía ---------- */
  .guia { padding-block: 44px 56px; }
  .guia-cabeza { display: grid; gap: 4px; margin-bottom: 20px; }
  .guia-titulo { font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 750; letter-spacing: -0.04em; }
  .guia-estado { color: var(--texto-2); font-weight: 550; }

  .controles { display: grid; gap: 14px; margin-bottom: 26px; padding-bottom: 20px; border-bottom: 1px solid var(--linea); }
  .controles-ubicacion { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .estoy-en { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.92rem; color: var(--texto-2); }
  .estoy-en select {
    min-height: 42px; padding: 0 34px 0 14px; border-radius: 999px; border: 1px solid var(--linea); background: var(--placa); color: var(--texto);
    font: 600 0.92rem var(--f); appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: right 17px top 52%, right 12px top 52%; background-size: 5px 5px; background-repeat: no-repeat;
  }
  .vistas { display: inline-flex; margin-left: auto; padding: 3px; border-radius: 999px; border: 1px solid var(--linea); background: var(--placa); }
  .vistas button { display: inline-flex; align-items: center; gap: 0.4em; min-height: 36px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; font-weight: 650; font-size: 0.88rem; color: var(--texto-2); }
  .vistas button[aria-selected='true'] { background: var(--texto); color: var(--fondo); }
  .aviso { font-size: 0.92rem; font-weight: 550; padding: 10px 14px; border-radius: 12px; background: var(--acento-suave); color: var(--texto); max-width: 70ch; }

  .filtros { display: grid; gap: 10px; }
  .filtro { display: grid; grid-template-columns: 76px minmax(0, 1fr); align-items: center; gap: 10px; }
  .filtro-nombre { font-size: 0.84rem; font-weight: 650; color: var(--texto-3); }
  .chips { display: flex; gap: 6px; overflow-x: auto; padding: 2px; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .limpiar { display: inline-flex; align-items: center; gap: 0.35em; min-height: 38px; padding: 0 10px; border: 0; background: none; font-weight: 650; font-size: 0.9rem; color: var(--acento); white-space: nowrap; }
  @media (max-width: 640px) {
    .filtro { grid-template-columns: 1fr; gap: 4px; }
    .vistas { margin-left: 0; }
  }

  /* Antes de que corra el script solo se ven 12 (el script luego usa hidden). */
  .lugares:not(.listo) > :global(.lugar:nth-child(n + 13)) { display: none; }
  .mas { display: flex; justify-content: center; margin-top: 26px; }
  .lugares { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 16px; margin: 0; padding: 0; align-items: start; }
  .vacio { display: grid; justify-items: start; gap: 8px; padding: 28px; border-radius: var(--r); background: var(--placa-2); }
  .vacio-titulo { font-weight: 700; font-size: 1.2rem; }
  .mapa { height: min(72vh, 640px); border-radius: var(--r); overflow: hidden; border: 1px solid var(--linea); background: var(--placa-2); }

  /* ---------- Invitación al plan ---------- */
  .plan {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 20px;
    margin-bottom: 56px; padding: clamp(20px, 3vw, 32px); border-radius: 20px;
  }
  .plan-logo { width: 72px; height: 72px; border-radius: 50%; }
  .plan-titulo { font-size: clamp(1.3rem, 2.4vw, 1.7rem); font-weight: 700; }
  .plan p { color: var(--texto-2); margin-top: 4px; max-width: 60ch; }
  @media (max-width: 700px) {
    .plan { grid-template-columns: auto 1fr; }
    .plan .boton { grid-column: 1 / -1; justify-self: start; }
  }
</style>
