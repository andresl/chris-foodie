---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Icono from '../components/Icono.astro';
import logo from '../assets/logo-cookfoodie.png';
import { lugares, primeraFrase } from '../lib/datos';
import { intro } from '../lib/preguntas';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/reviews/*.{jpg,jpeg,png,webp}', { eager: true });
const datos = await Promise.all(lugares.map(async (l) => {
  const f = l.review?.images?.[0]?.file;
  const meta = f ? fotos[`../assets/reviews/${f}`]?.default : undefined;
  const img = meta ? (await getImage({ src: meta, width: 760, format: 'webp' })).src : null;
  return {
    s: l.slug, n: l.name, h: l.hood, r: l.region, adj: l.adj, m: l.meals, p: l.price, t: l.tags,
    plato: l.plato, nota: primeraFrase(l.note, 170), pr: l.priority, lat: l.lat, lng: l.lng, maps: l.maps,
    rv: l.review && l.review.status !== 'in_progress' ? l.review.rating : null, img,
  };
}));
---
<Base titulo="Plan my meal · CookFoodie San Francisco" descripcion="Ten quick questions from Cvander: World Cup or MLS, beer or mezcal, a line or no line. You get a San Francisco place, a dish and two backups.">
  <section class="juego envoltura" data-juego>
    <div class="avance" aria-hidden="true" data-avance>
      {Array.from({ length: 10 }).map(() => <span class="avance-paso"></span>)}
      <span class="avance-num num" data-avance-num></span>
    </div>

    <div class="anfitrion">
      <Image src={logo} alt="" width={64} height={64} class="anfitrion-logo" loading="eager" />
      <div>
        <p class="anfitrion-nombre">Cvander</p>
        <p class="anfitrion-dice" data-dice aria-live="polite"><T en="Ten questions, one plan" es="Diez preguntas, un plan" /></p>
      </div>
    </div>

    <h1 class="pregunta" data-pregunta tabindex="-1"><T en={intro.en} es={intro.es} /></h1>

    <div class="opciones" data-opciones>
      <button type="button" class="boton empezar" data-empezar><T en="Start" es="Empezar" /><Icono n="flecha" /></button>
    </div>

    <p class="plan-parcial" data-parcial hidden></p>

    <div class="juego-nav">
      <button type="button" class="nav-atras" data-atras hidden><Icono n="izq" /><T en="Back" es="Atrás" /></button>
      <a class="nav-salir" href="/#guia"><T en="Skip to the guide" es="Mejor ver la guía" /></a>
    </div>

    <div class="resultado" data-resultado hidden>
      <div data-principal></div>
      <div class="resultado-acciones">
        <button type="button" class="boton borde" data-compartir><Icono n="compartir" /><T en="Send the plan" es="Mandar el plan" /></button>
        <button type="button" class="boton borde" data-otra><Icono n="otra" /><T en="Play again" es="Jugar otra vez" /></button>
        <p class="copiado" data-copiado hidden><T en="Link copied. Paste it in the group chat." es="Link copiado. Pégalo en el chat del grupo." /></p>
      </div>
      <h2 class="alternas-titulo"><T en="If that one is full" es="Si ese está lleno" /></h2>
      <ol class="alternas" data-alternas></ol>
    </div>
  </section>

  <script type="application/json" id="datos-juego" set:html={JSON.stringify(datos)} />
</Base>

<script>
  import { iniciarJuego } from '../scripts/juego';
  iniciarJuego();
</script>

<style>
  .juego { display: grid; gap: 24px; max-width: 820px; padding-block: 36px 72px; min-height: calc(100dvh - 64px); align-content: start; }

  .avance { display: grid; grid-template-columns: repeat(10, 1fr) auto; gap: 5px; align-items: center; }
  .avance-paso { height: 5px; border-radius: 5px; background: var(--linea); transition: background 400ms var(--ease), transform 400ms var(--ease); transform-origin: left; }
  .avance-paso.hecho { background: var(--acento); }
  .avance-paso.actual { background: var(--texto-3); }
  .avance-num { margin-left: 8px; font-size: 0.85rem; font-weight: 650; color: var(--texto-3); min-width: 3.2em; text-align: right; }

  .anfitrion { display: flex; align-items: center; gap: 14px; }
  .anfitrion-logo { width: 64px; height: 64px; border-radius: 50%; transition: transform 500ms var(--ease); }
  .anfitrion-logo.habla { transform: rotate(-8deg) scale(1.06); }
  .anfitrion-nombre { font-weight: 750; letter-spacing: -0.02em; }
  .anfitrion-dice { color: var(--acento); font-weight: 600; min-height: 1.55em; }
  .anfitrion-dice.nuevo { animation: aparece 420ms var(--ease); }
  @keyframes aparece { from { opacity: 0; transform: translateY(6px); } }

  .pregunta { font-size: clamp(1.7rem, 4vw, 2.6rem); font-weight: 720; letter-spacing: -0.04em; line-height: 1.12; outline: none; max-width: 24ch; }
  .pregunta.nuevo { animation: aparece 480ms var(--ease); }

  .opciones { display: grid; gap: 10px; grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr)); }
  .opciones.entra > :global(*) { animation: entra 460ms var(--ease) both; animation-delay: calc(var(--i, 0) * 40ms); }
  @keyframes entra { from { opacity: 0; transform: translateY(10px); } }
  .opciones :global(.opcion) {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 60px; padding: 14px 18px; border-radius: 14px; text-align: left;
    border: 1px solid var(--linea); background: var(--placa); color: var(--texto);
    font-weight: 600; font-size: 1.05rem; line-height: 1.3;
    transition: transform 200ms var(--ease), border-color 200ms, box-shadow 200ms var(--ease), background 200ms;
  }
  .opciones :global(.opcion::after) { content: ''; width: 18px; height: 18px; flex: none; border-radius: 50%; border: 1.5px solid var(--linea); transition: background 200ms, border-color 200ms, box-shadow 200ms; }
  .opciones :global(.opcion:hover) { transform: translateY(-2px); border-color: var(--texto-3); box-shadow: var(--sombra); }
  .opciones :global(.opcion:active) { transform: scale(0.98); }
  .opciones :global(.opcion.elegida) { border-color: var(--acento); background: var(--acento-suave); }
  .opciones :global(.opcion.elegida::after) { border-color: var(--acento); background: var(--acento); box-shadow: inset 0 0 0 3px var(--placa); }
  .empezar { justify-self: start; grid-column: 1 / -1; }
  @media (max-width: 560px) { .opciones { --cols: 1 !important; } }

  .plan-parcial { font-size: 0.92rem; color: var(--texto-2); font-weight: 550; }
  .plan-parcial :global(b) { color: var(--texto); font-weight: 700; }

  .juego-nav { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .nav-atras, .nav-salir { display: inline-flex; align-items: center; gap: 0.4em; min-height: 44px; padding: 0 4px; border: 0; background: none; color: var(--texto-2); font-weight: 600; text-decoration: none; }
  .nav-atras:hover, .nav-salir:hover { color: var(--texto); text-decoration: underline; }
  .nav-salir { margin-left: auto; }

  .resultado { display: grid; gap: 22px; }
  .resultado :global(.plan-tarjeta) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); overflow: hidden; border-radius: 20px; background: var(--placa); border: 1px solid var(--linea); box-shadow: var(--sombra-alta); animation: aparece 600ms var(--ease); }
  .resultado :global(.plan-cara) { position: relative; min-height: 300px; background: var(--placa-2); overflow: hidden; }
  .resultado :global(.plan-cara img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: acerca 1400ms var(--ease); }
  @keyframes acerca { from { transform: scale(1.08); } }
  .resultado :global(.plan-cara.sin-foto) { display: grid; place-items: center; padding: 28px; background: var(--acento-suave); }
  .resultado :global(.plan-cara.sin-foto p) { font-size: clamp(1.2rem, 2.4vw, 1.5rem); font-weight: 650; line-height: 1.35; color: var(--texto); }
  .resultado :global(.plan-info) { display: grid; align-content: start; gap: 12px; padding: clamp(20px, 3vw, 30px); }
  .resultado :global(.plan-etiqueta) { font-size: 0.85rem; font-weight: 650; color: var(--acento); }
  .resultado :global(.plan-titulo) { font-size: clamp(1.6rem, 3.6vw, 2.3rem); font-weight: 750; letter-spacing: -0.04em; line-height: 1.05; }
  .resultado :global(.plan-plato) { font-weight: 600; font-size: 1.08rem; color: var(--texto-2); }
  .resultado :global(.plan-lugar) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; padding-top: 10px; border-top: 1px solid var(--linea); }
  .resultado :global(.plan-lugar strong) { font-size: 1.25rem; font-weight: 720; letter-spacing: -0.02em; }
  .resultado :global(.plan-lugar span) { color: var(--texto-2); font-weight: 550; font-size: 0.95rem; }
  .resultado :global(.plan-nota) { color: var(--texto-2); }
  .resultado :global(.plan-razones) { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .resultado :global(.plan-razones li) { padding: 3px 11px; border-radius: 999px; background: var(--placa-2); font-weight: 600; font-size: 0.84rem; color: var(--texto-2); }
  .resultado :global(.plan-botones) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  @media (max-width: 720px) { .resultado :global(.plan-tarjeta) { grid-template-columns: 1fr; } .resultado :global(.plan-cara) { min-height: 230px; } }
  .resultado-acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .copiado { font-weight: 600; color: var(--acento); }
  .alternas-titulo { font-size: 1.3rem; font-weight: 720; margin-top: 6px; }
  .alternas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 12px; }
  .alternas :global(a) { display: grid; gap: 4px; padding: 16px 18px; border-radius: 14px; background: var(--placa); border: 1px solid var(--linea); color: var(--texto); text-decoration: none; transition: transform 220ms var(--ease), box-shadow 220ms var(--ease); }
  .alternas :global(a:hover) { transform: translateY(-2px); box-shadow: var(--sombra); }
  .alternas :global(strong) { font-weight: 700; font-size: 1.08rem; }
  .alternas :global(span) { color: var(--texto-2); font-weight: 550; font-size: 0.92rem; }
</style>
