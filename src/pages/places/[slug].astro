---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Icono from '../../components/Icono.astro';
import Parada from '../../components/Parada.astro';
import logo from '../../assets/logo-cookfoodie.png';
import { lugares, comidas, insignias, vecinos, type Lugar } from '../../lib/datos';

export function getStaticPaths() {
  return lugares.map((l) => ({ params: { slug: l.slug }, props: { lugar: l } }));
}

const { lugar: l } = Astro.props as { lugar: Lugar };
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/reviews/*.{jpg,jpeg,png,webp}', { eager: true });
const imagenes = (l.review?.images ?? []).map((i) => ({ ...i, src: fotos[`../../assets/reviews/${i.file}`]?.default })).filter((i) => i.src);
const rv = l.review;
const enProgreso = rv?.status === 'in_progress';
const cerca = vecinos(l);
const codigoIg = (u: string) => u.match(/\/(p|reel)\/([^/]+)/)?.[2];
const descripcion = `${l.name}, ${l.hood}. ${l.note.slice(0, 140)}`;
const visibles = l.tags.filter((t) => t in insignias);
---
<Base titulo={`${l.name} · CookFoodie San Francisco`} descripcion={descripcion}>
  <article class="ficha">
    <header class="ficha-cabeza">
      <div class="envoltura ficha-cabeza-fila">
        <a class="volver" href="/#guia"><Icono n="izq" /><T en="Back to the guide" es="Volver a la guía" /></a>
        <div class="ficha-letrero">
          <p class="ficha-ruta">
                        <span class="cap"><T en={l.adj.en} es={l.adj.es} /></span>
            <span>{l.hood}</span>
            <span data-distancia-ficha data-lat={l.lat} data-lng={l.lng} class="ficha-distancia" hidden></span>
          </p>
          <h1 class="ficha-nombre">{l.name}</h1>
          <ul class="ficha-datos">
            <li class="precio" title={l.priceEst ? 'Estimate / Estimado' : undefined}>{l.price}</li>
            {l.meals.map((m) => comidas[m] && <li><T en={comidas[m].en} es={comidas[m].es} /></li>)}
            {visibles.map((t) => <li><Icono n={insignias[t].icono} /><T en={insignias[t].en} es={insignias[t].es} /></li>)}
          </ul>
          <div class="ficha-acciones">
            <a class="boton" href={l.maps} rel="noopener"><Icono n="navegar" /><T en="Directions" es="Cómo llegar" /></a>
            {l.instagram && <a class="boton borde" href={l.instagram} rel="noopener"><Icono n="instagram" />Instagram</a>}
            {l.website && <a class="boton borde" href={l.website} rel="noopener"><Icono n="web" /><T en="Website" es="Sitio web" /></a>}
          </div>
          <p class="direccion"><Icono n="pin" />{l.address}</p>
        </div>
      </div>
    </header>

    <div class="envoltura ficha-cuerpo">
      <section class="voz" aria-label="Chris">
        <Image src={logo} alt="" width={72} height={72} class="voz-foto" />
        <div>
          <p class="voz-quien"><T en="Chris says" es="Chris dice" /></p>
          <blockquote class="voz-nota" lang="en">{l.note}</blockquote>
          {rv?.rating && !enProgreso && (
            <p class="voz-estrellas" aria-label={`${rv.rating} / 5`}>
              {Array.from({ length: 5 }).map((_, i) => <span class={i < rv.rating! ? 'llena' : ''}><Icono n="estrella" /></span>)}
              <span class="voz-fecha"><T en="CookFoodie review" es="Reseña en CookFoodie" />{rv.date && ` · ${rv.date}`}</span>
            </p>
          )}
          {enProgreso && <p class="voz-fecha"><T en="Review in progress on cookfoodie.com" es="Reseña en camino en cookfoodie.com" /></p>}
        </div>
      </section>

      {rv && rv.dishes.length > 0 && (
        <section class="menu" aria-labelledby="menu-t">
          <h2 id="menu-t" class="menu-titulo"><T en="What Chris orders" es="Lo que pide Chris" /></h2>
          <ol class="menu-lista" lang="en">
            {rv.dishes.map((d) => (
              <li><span class="menu-plato">{d.name}</span><span class="menu-nota">{d.description}</span></li>
            ))}
          </ol>
        </section>
      )}

      {l.reel && (
        <section class="reel" aria-labelledby="reel-t">
          <h2 id="reel-t" class="seccion-titulo"><T en="The visit, on video" es="La visita, en video" /></h2>
          <div class="reel-fila">
            <video class="reel-video" controls playsinline preload="none" poster={l.reel.poster} width="360" height="640">
              <source src={l.reel.video} type="video/mp4" />
            </video>
            <p class="reel-nota">
              <T en="Recorded by Chris on the visit." es="Grabado por Chris en la visita." />
              {l.reel.url && <a href={l.reel.url} rel="noopener"><Icono n="instagram" /><T en="See it on Instagram" es="Verlo en Instagram" /></a>}
            </p>
          </div>
        </section>
      )}

      {imagenes.length > 0 && (
        <section class="galeria" aria-labelledby="gal-t">
          <h2 id="gal-t" class="seccion-titulo"><T en="Chris's photos" es="Las fotos de Chris" /></h2>
          <div class="galeria-pista">
            {imagenes.map((i, n) => (
              <figure class="galeria-foto">
                <Image src={i.src!} alt={i.caption || l.name} widths={[420, 720]} sizes="(max-width: 700px) 82vw, 420px" loading={n < 2 ? 'eager' : 'lazy'} />
                {i.caption && <figcaption lang="en">{i.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )}

      {rv && rv.personal.length > 0 && (
        <section class="resena" aria-labelledby="res-t">
          <h2 id="res-t" class="seccion-titulo"><T en="The review" es="La reseña" /></h2>
          <div class="resena-texto" lang="en">
            {rv.personal.map((p) => <p>{p}</p>)}
          </div>
          {rv.reservationTip && (
            <p class="consejo"><Icono n="calendario" /><span><strong><T en="Booking tip" es="Para reservar" /></strong> <span lang="en">{rv.reservationTip}</span></span></p>
          )}
          <a class="enlace-fuente" href={rv.url} rel="noopener"><T en="Read it on cookfoodie.com" es="Leerla en cookfoodie.com" /><Icono n="sale" /></a>
        </section>
      )}

      {rv?.guest && (
        <section class="invitado" aria-labelledby="inv-t">
          <h2 id="inv-t" class="seccion-titulo"><T en={`A friend's take: ${rv.guest.author}`} es={`La opinión de ${rv.guest.author}`} /></h2>
          {rv.guest.intro && <p class="invitado-intro">{rv.guest.intro}</p>}
          {rv.guest.paragraphs?.map((p: string) => <p>{p}</p>)}
        </section>
      )}

      {rv && rv.faqs.length > 0 && (
        <section class="preguntas" aria-labelledby="faq-t">
          <h2 id="faq-t" class="seccion-titulo"><T en="Quick answers" es="Respuestas rápidas" /></h2>
          <div lang="en">
            {rv.faqs.map((f) => (
              <details>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {l.igPosts.length > 0 && (
        <section class="instagram" aria-labelledby="ig-t">
          <h2 id="ig-t" class="seccion-titulo"><T en="On @cookfoodie" es="En @cookfoodie" /></h2>
          {l.igPosts.map((p) => (
            <div class="ig-caja" data-ig={codigoIg(p.url)}>
              <p class="ig-texto" lang="en">“{p.text}”<span class="ig-fecha">{p.date}</span></p>
              <button type="button" class="boton borde chico" data-ig-cargar><Icono n="instagram" /><T en="Show the post" es="Ver la publicación" /></button>
              <a class="enlace-fuente" href={p.url} rel="noopener"><T en="Open on Instagram" es="Abrir en Instagram" /><Icono n="sale" /></a>
            </div>
          ))}
        </section>
      )}

      {!rv && (
        <section class="sin-resena">
          <p>
            <T en="No full review yet: this one is on Chris's list, with his note above. Photos stay his, so there are none here until he posts them."
               es="Todavía sin reseña completa: está en la lista de Chris, con su nota de arriba. Las fotos son suyas, así que aquí no hay hasta que él las publique." />
          </p>
          {l.reviewLink && <a class="enlace-fuente" href={`/places/${l.reviewLink}`}><T en="Read the Burma Love review" es="Leer la reseña de Burma Love" /><Icono n="flecha" /></a>}
        </section>
      )}

      <section class="cercanas" aria-labelledby="cer-t">
        <h2 id="cer-t" class="seccion-titulo"><T en="Nearby" es="Cerca de aquí" /></h2>
        <ol class="cercanas-lista">
          {cerca.map((c) => <Parada lugar={c.lugar} />)}
        </ol>
      </section>
    </div>
  </article>
</Base>

<script>
  import { leerPosicion, millas, formatoDistancia, idioma } from '../../scripts/comun';
  const el = document.querySelector<HTMLElement>('[data-distancia-ficha]');
  const pintar = () => {
    const pos = leerPosicion();
    if (!el || !pos) return;
    const d = millas(pos, { lat: +el.dataset.lat!, lng: +el.dataset.lng! });
    el.hidden = false;
    el.textContent = formatoDistancia(d, idioma(), true);
  };
  pintar();
  document.addEventListener('cf:lang', pintar);

  // Instagram: el embed oficial solo se carga cuando la persona lo pide.
  document.querySelectorAll<HTMLElement>('[data-ig]').forEach((caja) => {
    caja.querySelector('[data-ig-cargar]')?.addEventListener('click', (e) => {
      const marco = document.createElement('iframe');
      marco.src = `https://www.instagram.com/p/${caja.dataset.ig}/embed/captioned/`;
      marco.title = 'Instagram';
      marco.loading = 'lazy';
      marco.className = 'ig-marco';
      marco.setAttribute('allowtransparency', 'true');
      (e.currentTarget as HTMLElement).replaceWith(marco);
    });
  });
</script>

<style>
  .ficha-cabeza { border-bottom: 1px solid var(--linea); }
  .ficha-cabeza-fila { padding-block: 18px 32px; display: grid; gap: 16px; }
  .volver { display: inline-flex; align-items: center; gap: 0.4em; width: fit-content; min-height: 40px; font-weight: 600; text-decoration: none; color: var(--texto-2); }
  .volver:hover { color: var(--texto); text-decoration: underline; }
  .ficha-letrero { display: grid; gap: 14px; }
  .ficha-ruta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-weight: 600; font-size: 0.95rem; color: var(--texto-2); }
  .cap { color: var(--acento); font-weight: 650; }
  .cap::first-letter { text-transform: uppercase; }
  .ficha-distancia { color: var(--texto); font-weight: 650; }
  .ficha-nombre { font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 750; letter-spacing: -0.045em; line-height: 1; overflow-wrap: anywhere; }
  .ficha-datos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ficha-datos li { display: inline-flex; align-items: center; gap: 0.35em; padding: 3px 11px; border-radius: 999px; background: var(--placa-2); font-weight: 600; font-size: 0.85rem; color: var(--texto-2); }
  .ficha-datos .precio { font-variant-numeric: tabular-nums; color: var(--texto); }
  .ficha-acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .direccion { display: inline-flex; align-items: center; gap: 0.4em; color: var(--texto-3); font-size: 0.92rem; }

  .ficha-cuerpo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 52px; padding-block: 40px 64px; max-width: 940px; }
  .ficha-cuerpo > * { min-width: 0; }
  .seccion-titulo, .menu-titulo { font-size: clamp(1.35rem, 2.6vw, 1.75rem); font-weight: 720; letter-spacing: -0.035em; margin-bottom: 16px; }

  .voz { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: start; }
  .voz-foto { width: 64px; height: 64px; border-radius: 50%; }
  .voz-quien { font-weight: 650; color: var(--acento); font-size: 0.92rem; }
  .voz-nota { margin: 6px 0 0; font-size: clamp(1.25rem, 2.4vw, 1.6rem); line-height: 1.4; font-weight: 550; letter-spacing: -0.02em; max-width: 58ch; }
  .voz-estrellas { display: flex; flex-wrap: wrap; align-items: center; gap: 2px; margin-top: 12px; color: var(--linea); }
  .voz-estrellas .llena { color: var(--acento); }
  .voz-estrellas :global(.icono) { width: 1.25em; height: 1.25em; }
  .voz-fecha { margin-left: 10px; color: var(--texto-3); font-weight: 550; font-size: 0.9rem; }

  .menu { padding: clamp(20px, 4vw, 32px); border-radius: 20px; background: var(--placa); border: 1px solid var(--linea); }
  .menu-lista { margin: 0; padding: 0; list-style: none; display: grid; gap: 18px; counter-reset: plato; }
  .menu-lista li { display: grid; grid-template-columns: auto 1fr; column-gap: 14px; counter-increment: plato; }
  .menu-lista li::before { content: counter(plato); grid-row: span 2; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--acento-suave); color: var(--acento); font-weight: 700; font-size: 0.85rem; }
  .menu-plato { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; }
  .menu-nota { color: var(--texto-2); }

  .reel-fila { display: grid; grid-template-columns: minmax(0, 320px) 1fr; gap: 24px; align-items: end; }
  .reel-video { width: 100%; height: auto; aspect-ratio: 9 / 16; border-radius: 18px; background: #000; }
  .reel-nota { display: grid; gap: 10px; color: var(--texto-2); }
  .reel-nota a { display: inline-flex; align-items: center; gap: 0.4em; font-weight: 650; color: var(--texto); }
  @media (max-width: 640px) { .reel-fila { grid-template-columns: 1fr; } }

  .galeria-pista { display: grid; grid-auto-flow: column; grid-auto-columns: min(82vw, 420px); gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; scrollbar-width: thin; }
  .galeria-foto { margin: 0; scroll-snap-align: start; }
  .galeria-foto :global(img) { width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; border-radius: 16px; }
  .galeria-foto figcaption { margin-top: 8px; font-size: 0.9rem; color: var(--texto-2); }

  .resena-texto { display: grid; gap: 14px; max-width: 68ch; }
  .consejo { display: flex; gap: 10px; margin-top: 20px; padding: 14px 16px; border-radius: 14px; background: var(--acento-suave); max-width: 68ch; }
  .enlace-fuente { display: inline-flex; align-items: center; gap: 0.4em; margin-top: 16px; font-weight: 650; color: var(--acento); }

  .invitado { display: grid; gap: 12px; max-width: 68ch; padding: 22px; border-radius: 18px; background: var(--placa-2); }
  .invitado .seccion-titulo { margin-bottom: 0; }
  .invitado-intro { font-weight: 650; }

  .preguntas details { border-bottom: 1px solid var(--linea); max-width: 72ch; }
  .preguntas summary { cursor: pointer; min-height: 52px; display: flex; align-items: center; font-weight: 650; }
  .preguntas details p { padding-bottom: 16px; color: var(--texto-2); }

  .ig-caja { display: grid; gap: 12px; justify-items: start; padding: 20px; border-radius: 18px; background: var(--placa); border: 1px solid var(--linea); max-width: 560px; margin-bottom: 14px; }
  .ig-texto { font-size: 1.12rem; font-weight: 650; }
  .ig-fecha { display: block; font-size: 0.85rem; font-weight: 550; color: var(--texto-3); }
  .ig-caja :global(.ig-marco) { width: 100%; min-height: 620px; border: 0; border-radius: 12px; background: #fff; }

  .sin-resena { display: grid; gap: 4px; padding: 20px; border-radius: 18px; background: var(--placa-2); max-width: 68ch; color: var(--texto-2); }
  .cercanas-lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: 14px; margin: 0; padding: 0; align-items: start; }
</style>
