---
import '../styles/global.css';
import T from '../components/T.astro';
import Icono from '../components/Icono.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo-cookfoodie.png';

interface Props { titulo: string; descripcion: string; imagen?: string }
const { titulo, descripcion, imagen } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-lang="en" data-paleta="tomate">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {imagen && <meta property="og:image" content={new URL(imagen, Astro.site)} />}
    <meta name="theme-color" content="#d42a1e" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      // Idioma antes de pintar: lo guardado, si no el del navegador.
      (function () {
        var l = null;
        try { l = localStorage.getItem('cf-lang'); } catch (e) {}
        if (!l) l = (navigator.language || 'en').toLowerCase().indexOf('es') === 0 ? 'es' : 'en';
        document.documentElement.dataset.lang = l;
        document.documentElement.lang = l;
        // Paleta en prueba: ?paleta=tomate|mostaza|noche, recordada en este navegador.
        var p = new URLSearchParams(location.search).get('paleta');
        try { if (p) localStorage.setItem('cf-paleta', p); else p = localStorage.getItem('cf-paleta'); } catch (e) {}
        if (p === 'tomate' || p === 'mostaza' || p === 'noche') document.documentElement.dataset.paleta = p;
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido"><T en="Skip to content" es="Saltar al contenido" /></a>
    <header class="cabeza en-campo">
      <div class="envoltura cabeza-fila">
        <a class="marca" href="/">
          <Image src={logo} alt="" width={36} height={36} class="marca-logo" loading="eager" />
          <span class="marca-nombre">CookFoodie</span>
          <span class="marca-ciudad">San Francisco</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/#guia" class="nav-link"><Icono n="tenedor" /><span><T en="Guide" es="La guía" /></span></a>
          <a href="/juego" class="nav-link"><Icono n="chispa" /><span><T en="Plan my meal" es="Arma tu plan" /></span></a>
          <div class="idioma" role="group" aria-label="Language / Idioma">
            <button type="button" data-lang-set="en" aria-label="English">EN</button>
            <button type="button" data-lang-set="es" aria-label="Español">ES</button>
          </div>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie en-pie">
      <div class="envoltura pie-fila">
        <div class="pie-marca">
          <span class="pie-logo"><Image src={logo} alt="" width={44} height={44} class="marca-logo grande" /><span class="marca-nombre">CookFoodie</span></span>
          <p>
            <T en="Honest reviews and the places Christian Van Der Henst keeps going back to in San Francisco. Notes, reviews and photos are his."
               es="Reseñas honestas y los lugares a los que Christian Van Der Henst siempre vuelve en San Francisco. Notas, reseñas y fotos son suyas." />
          </p>
        </div>
        <ul class="pie-links">
          <li><a href="https://www.cookfoodie.com" rel="noopener"><Icono n="web" /> cookfoodie.com</a></li>
          <li><a href="https://www.instagram.com/cookfoodie/" rel="noopener"><Icono n="instagram" /> @cookfoodie</a></li>
          <li><a href="https://x.com/cvander" rel="noopener"><Icono n="x" /> @cvander</a></li>
        </ul>
      </div>
      <p class="envoltura pie-nota">
        <T en="Design demo. Distances are straight lines from where you are; check hours before you go."
           es="Demo de diseño. Las distancias son en línea recta desde donde estás; revisa horarios antes de ir." />
      </p>
    </footer>

    <script>
      const marcar = (l: string) => {
        document.documentElement.dataset.lang = l;
        document.documentElement.lang = l;
        try { localStorage.setItem('cf-lang', l); } catch {}
        document.querySelectorAll<HTMLButtonElement>('[data-lang-set]').forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.langSet === l)));
        document.dispatchEvent(new CustomEvent('cf:lang', { detail: l }));
      };
      document.querySelectorAll<HTMLButtonElement>('[data-lang-set]').forEach((b) =>
        b.addEventListener('click', () => marcar(b.dataset.langSet!)));
      marcar(document.documentElement.dataset.lang || 'en');
    </script>
  </body>
</html>

<style>
  .saltar { position: absolute; left: 12px; top: -60px; z-index: 30; background: var(--acento); color: var(--sobre-acento); padding: 10px 16px; border-radius: 999px; font-weight: 700; }
  .saltar:focus { top: 12px; }

  .cabeza { position: sticky; top: 0; z-index: 20; }
  .cabeza-fila { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 64px; }
  .marca { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .marca-logo { width: 36px; height: 36px; border-radius: 50%; }
  .marca-nombre { font-weight: 800; font-size: 1.3rem; letter-spacing: -0.04em; color: var(--texto); }
  .marca-ciudad { font-weight: 550; font-size: 0.9rem; color: var(--texto-2); }
  .nav { display: flex; align-items: center; gap: 2px; }
  .nav-link { display: inline-flex; align-items: center; gap: 0.45em; min-height: 44px; padding: 0 12px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 0.95rem; color: var(--texto-2); }
  .nav-link:hover { color: var(--texto); background: var(--placa-2); }
  .idioma { display: inline-flex; margin-left: 6px; padding: 3px; border-radius: 999px; border: 1px solid var(--linea); }
  .idioma button { min-width: 38px; min-height: 34px; border: 0; border-radius: 999px; background: transparent; color: var(--texto-2); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; }
  .idioma button[aria-pressed='true'] { background: var(--texto); color: var(--campo); }
  @media (max-width: 600px) {
    .nav-link span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .nav-link { padding: 0 10px; }
    .nav-link :global(.icono) { width: 1.3em; height: 1.3em; }
    .marca-ciudad { display: none; }
  }

  .pie { margin-top: 0; }
  .pie-fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 28px; padding-block: 40px 16px; }
  .pie-marca { max-width: 48ch; }
  .pie-logo { display: inline-flex; align-items: center; gap: 10px; }
  .marca-logo.grande { width: 44px; height: 44px; }
  .pie-marca p { margin-top: 8px; color: var(--texto-2); }
  .pie-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .pie-links a { display: inline-flex; align-items: center; gap: 0.5em; min-height: 40px; font-weight: 600; text-decoration: none; color: var(--texto-2); }
  .pie-links a:hover { color: var(--texto); }
  .pie-nota { padding-bottom: 32px; color: var(--texto-3); font-size: 0.875rem; }
</style>
